# Project exclude paths
/.gradle/
/build/

# Cached API responses. Every fetch is written to the working directory as
# <prefix><today>.txt and reused for the rest of the day; delete them to force
# a refresh.
/*.txt
/sleeperDataPlayerAPI.json

# TradeFinder output - hundreds of megabytes of candidate trades.
/twoTeamTrade*.txt
/threeTeamTrade*.txt

# FantasyPros CSV exports, downloaded by hand.
/FantasyPros_*.csv

# Subscriber projection exports are personal-use data - never committed.
data/external-projections/*.csv

# nflverse weekly player stats 1999-2025, ~130MB for the 16 seasons we use.
# Fetched, not authored - re-downloadable from the nflverse-data releases, so
# it is ignored like the other heavy archives rather than committed.
data/nflverse/
